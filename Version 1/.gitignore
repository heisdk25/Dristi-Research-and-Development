# ==============================================================================
# Drishti: Research & Development — Git Ignore Rules
# ==============================================================================

# Environment & Secrets (NEVER COMMIT)
*.env
*.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
credentials.json
client_secret*.json
google-services.json

# Android Build Artifacts & Machine Paths
.gradle/
build/
**/build/
local.properties
.cxx/
*.apk
*.ap_
*.aab
*.dex
*.class
*.tflite.bin

# Python Environments & Caches
.venv/
venv/
**/venv/
**/__pycache__/
*.py[cod]
*.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Web Artifacts
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs & Operating System Artifacts
.idea/
**/.idea/
.vscode/
**/.vscode/
.DS_Store
Thumbs.db
*.log
.kilo/
.kombai/

# Scratch & Temporary Agent Files
scratch/

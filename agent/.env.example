# ── LiveKit Cloud ──
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── AI Models & Services ──
LLM_PROVIDER=groq
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-flash-latest
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# ── Voice Provider Selection (sarvam | elevenlabs | openai) ──
TTS_PROVIDER=sarvam
STT_PROVIDER=sarvam

# ── Sarvam AI (Indian Low Latency Multilingual) ──
SARVAM_API_KEY=...
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=kabir
SARVAM_TTS_PACE=1.25

# ── ElevenLabs (Hyper-Realistic Global Voice) ──
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_MODEL=eleven_turbo_v2_5

GOOGLE_MAPS_API_KEY=...
DEFAULT_AGENT_MODE=assistant

# ── LLM Conversation Observation & Telemetry ──
ENABLE_CONVERSATION_LOGS=true       # Master toggle for logging (true/false)
OBSERVER_TERMINAL_OUTPUT=true       # Color terminal cards (set to false for headless Docker)
OBSERVER_MAX_LOG_BYTES=10485760     # Auto-rotate log files at 10MB (in bytes)


# ==============================================================================
# Drishti — Unified Production Environment Configuration (Vultr / Cloud)
# ==============================================================================

# ── LiveKit Cloud / Server Credentials (Required) ──
# Get these from your LiveKit Cloud dashboard (https://cloud.livekit.io)
# or your self-hosted LiveKit instance.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── AI Model Provider Settings ──
# Options: 'google', 'groq', 'openai'
LLM_PROVIDER=google

# ── Google Gemini Configuration (Recommended for low-latency vision & voice) ──
GOOGLE_API_KEY=AIzaSy...
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_MAPS_API_KEY=AIzaSy...

# ── Sarvam AI Credentials (Indian Multilingual STT & TTS) ──
SARVAM_API_KEY=...
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=kabir
SARVAM_TTS_PACE=1.18

# ── Alternative LLM Providers (Groq / OpenAI) ──
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Agent Default Mode ──
# Options: 'assistant', 'navigation', 'ocr'
DEFAULT_AGENT_MODE=assistant

# ── Domain Configuration (Optional, for Caddy Automatic HTTPS SSL) ──
# If using a custom domain pointing to your Vultr server IP:
# DOMAIN=api.yourdomain.com
DOMAIN=localhost
